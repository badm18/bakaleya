{
  "name": "bakaleya",
  "version": "1.3.1",
  "description": "A Quasar Project",
  "productName": "Bakaleya",
  "author": "mikhail <shattilov@mail.ru>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,,html,md,json}\" --ignore-path .gitignore",
    "test": "node --test tests/db-upgrade.test.mjs",
    "dev": "quasar dev -m electron -- --no-sandbox --disable-setuid-sandbox",
    "dev:web": "quasar dev",
    "build": "quasar build -m electron",
    "postbuild": "node tests/verify-renderer-build.mjs",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "postinstall": "quasar prepare",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@quasar/extras": "2.1.0",
    "better-sqlite3": "13.2.0",
    "chart.js": "4.6.1",
    "electron-updater": "6.8.11",
    "pinia": "3.0.4",
    "quasar": "2.35.4",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@quasar/app-vite": "2.6.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.6.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite-plugin-checker": "1.0.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "qs": "6.17.1"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25 || >=26 <27 || >=28 <29 || >=30 <31",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
